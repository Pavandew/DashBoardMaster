<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    android:id="@+id/portal_cardMain"
    app:cardBackgroundColor="@color/dark_green"
    app:strokeWidth="0dp">

<com.google.android.material.card.MaterialCardView
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="16dp"
    android:layout_marginStart="5dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/white"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="12dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:gravity="center_vertical">

        <!-- Portal Icon Container -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/portal_cardIconBg"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginEnd="16dp"
            app:cardBackgroundColor="@color/dark_green"
            app:cardElevation="6dp"
            app:strokeWidth="0dp"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.MyApp.Squircle">

            <ImageView
                android:id="@+id/portal_ivMainIcon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_restaurant_24dp"
                app:tint="@android:color/white" />

        </com.google.android.material.card.MaterialCardView>

        <!-- Text Content -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/portal_tvTitleFirst"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Portal Dashboard"
                android:textSize="16sp"
                android:textColor="@color/dark_green"
                android:textStyle="bold" />


            <TextView
                android:id="@+id/portal_tvSubTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Login"
                android:textSize="13sp"
                android:textColor="@color/black"
                android:textStyle="bold" />


            <TextView
                android:id="@+id/portal_tvDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Quick access to portal features"
                android:textSize="13sp"
                android:textColor="@color/gray_text"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Navigation Arrow -->
        <ImageView
            android:id="@+id/portal_ivArrow"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:src="@drawable/ic_arrow_back_24dp"
            android:rotation="180"
            android:layout_marginTop="7dp"
            android:layout_gravity="center_vertical"
            android:padding="8dp"
            android:backgroundTint="@color/dark_green"
            android:background="@drawable/bg_circle_light_blue"
            app:tint="@color/white" />

    </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutFeatures"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="3dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:background="@android:color/white">

            <!-- Item 1 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivFeature1Icon"
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:src="@drawable/ic_restaurant_24dp"
                    app:tint="#4F6BFF"/>

                <TextView
                    android:id="@+id/tvFeature1Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Manage"
                    android:textColor="#1A1A3D"
                    android:textSize="10sp"/>
            </LinearLayout>

            <!-- Item 2 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivFeature2Icon"
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:src="@drawable/ic_analytics_24dp"
                    app:tint="#4F6BFF"/>

                <TextView
                    android:id="@+id/tvFeature2Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Reports"
                    android:textColor="#1A1A3D"
                    android:textSize="10sp"/>
            </LinearLayout>

            <!-- Item 3 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivFeature3Icon"
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:src="@drawable/ic_settings_24dp"
                    app:tint="#4F6BFF"/>

                <TextView
                    android:id="@+id/tvFeature3Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Settings"
                    android:textColor="#1A1A3D"
                    android:textSize="10sp"/>
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>


</com.google.android.material.card.MaterialCardView>
</com.google.android.material.card.MaterialCardView>