<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/portal_cardMain"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    app:cardCornerRadius="18dp"
    app:cardElevation="3dp"
    app:cardBackgroundColor="@color/white"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header Section: Icon, Titles, Description, Arrow -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="16dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp"
            android:gravity="center_vertical">

            <!-- Portal Icon Container (Squircle / Rounded Box) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/portal_cardIconBg"
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:layout_marginEnd="14dp"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="@color/portal_multi_bg_light"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <ImageView
                    android:id="@+id/portal_ivMainIcon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:src="@drawable/shield"
                    app:tint="@color/portal_multi_primary" />

            </com.google.android.material.card.MaterialCardView>

            <!-- Text Content -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/portal_tvTitleFirst"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Multi Restaurant"
                    android:textSize="16sp"
                    android:textColor="@color/portal_multi_primary"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/portal_tvSubTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Manage Multiple"
                    android:textSize="13sp"
                    android:textColor="@color/dark_text"
                    android:textStyle="bold"
                    android:layout_marginTop="2dp" />

                <TextView
                    android:id="@+id/portal_tvDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Manage all restaurants and system settings"
                    android:textSize="12sp"
                    android:textColor="@color/gray_text"
                    android:layout_marginTop="3dp" />
            </LinearLayout>

            <!-- Navigation Arrow Button -->
            <ImageView
                android:id="@+id/portal_ivArrow"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:src="@drawable/ic_arrow_back_24dp"
                android:rotation="180"
                android:layout_gravity="center_vertical"
                android:padding="9dp"
                android:background="@drawable/bg_circle_light_blue"
                android:backgroundTint="@color/portal_multi_primary"
                app:tint="@color/white" />

        </LinearLayout>

        <!-- Light Divider Line -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#F2F2F7"
            android:layout_marginHorizontal="16dp" />

        <!-- Sub Features Row -->
        <LinearLayout
            android:id="@+id/layoutFeatures"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp"
            android:paddingVertical="10dp"
            android:background="@android:color/white">

            <!-- Item 1 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivFeature1Icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_restaurant_24dp"
                    app:tint="@color/portal_multi_primary"/>

                <TextView
                    android:id="@+id/tvFeature1Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:text="Manage"
                    android:textColor="@color/portal_multi_primary"
                    android:textStyle="bold"
                    android:textSize="11sp"/>
            </LinearLayout>

            <!-- Item 2 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivFeature2Icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_analytics_24dp"
                    app:tint="@color/portal_multi_primary"/>

                <TextView
                    android:id="@+id/tvFeature2Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:text="Reports"
                    android:textColor="@color/portal_multi_primary"
                    android:textStyle="bold"
                    android:textSize="11sp"/>
            </LinearLayout>

            <!-- Item 3 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivFeature3Icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_settings_24dp"
                    app:tint="@color/portal_multi_primary"/>

                <TextView
                    android:id="@+id/tvFeature3Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:text="Settings"
                    android:textColor="@color/portal_multi_primary"
                    android:textStyle="bold"
                    android:textSize="11sp"/>
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>