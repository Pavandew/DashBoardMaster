<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".staff_dash.waiter_screens.order.views.OrderDetailExpansionFragment">

    <include
        android:id="@+id/orderDetailToolbar"
        layout="@layout/staff_custom_toolbar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nsvContentContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/layoutTotalsContainer"
        app:layout_constraintTop_toBottomOf="@id/orderDetailToolbar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/tv_title_25dp">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/margin_large"
                android:layout_marginTop="@dimen/margin_large"
                app:cardBackgroundColor="#F6F3F3"
                app:cardCornerRadius="@dimen/alert_card_radius"
                app:cardElevation="2dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/padding_medium">

                    <TextView
                        android:id="@+id/tvLabelTable"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/table_number"
                        android:textColor="@color/search_bar_hint"
                        android:textSize="@dimen/text_size_caption"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvExpandedTableId"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_tiny"
                        android:textColor="@color/table_id_text"
                        android:textSize="@dimen/text_size_20sp"
                        android:textStyle="bold"
                        tools:text="T-05"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvLabelTable" />

                    <TextView
                        android:id="@+id/tvLabelOrderId"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/order_id_label"
                        android:textColor="@color/search_bar_hint"
                        android:textSize="@dimen/text_size_caption"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvExpandedOrderId"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_tiny"
                        android:textColor="@color/table_id_text"
                        android:textSize="@dimen/text_size_20sp"
                        android:textStyle="bold"
                        tools:text="#ORD-1258"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvLabelOrderId" />

                    <TextView
                        android:id="@+id/tvExpandedStatusTag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_large"
                        android:background="@drawable/bg_status_preparing"
                        android:paddingHorizontal="@dimen/margin_medium"
                        android:paddingVertical="@dimen/order_card_margin_vertical"
                        android:textColor="@color/order_status_preparing"
                        android:textSize="@dimen/text_size_caption"
                        android:textStyle="bold"
                        tools:text="• Preparing"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvExpandedTableId" />

                    <TextView
                        android:id="@+id/tvLabelTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/time_label"
                        android:textColor="@color/search_bar_hint"
                        android:textSize="@dimen/text_size_medium"
                        app:layout_constraintBottom_toTopOf="@id/tvExpandedTimestamp"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <TextView
                        android:id="@+id/tvExpandedTimestamp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/chip_unselected_text"
                        android:textSize="@dimen/text_size_caption"
                        app:layout_constraintBottom_toBottomOf="@id/tvExpandedStatusTag"
                        app:layout_constraintEnd_toEndOf="parent"
                        tools:text="11 May 2026, 11:30 AM" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/margin_large"
                android:layout_marginTop="@dimen/tv_title_25dp"
                android:layout_marginBottom="@dimen/margin_small"
                android:text="@string/items"
                android:textColor="@color/order_table_text"
                android:textSize="@dimen/text_size_title"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvExpandedOrderItems"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:itemCount="6"
                tools:listitem="@layout/item_order_detail_row" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Sticky Totals Footer -->
    <LinearLayout
        android:id="@+id/layoutTotalsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/search_bar_bg"
        android:orientation="vertical"
        android:padding="@dimen/padding_medium"
        app:layout_constraintBottom_toTopOf="@id/layoutActionButtons">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/total"
                android:textColor="@color/chip_unselected_text"
                android:textSize="@dimen/text_size_title" />

            <TextView
                android:id="@+id/tvExpandedSubtotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/table_id_text"
                android:textSize="@dimen/text_size_title"
                android:textStyle="bold"
                tools:text="₹ 925" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_medium"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/gst_label"
                android:textColor="@color/chip_unselected_text"
                android:textSize="@dimen/text_size_title" />

            <TextView
                android:id="@+id/tvExpandedGst"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/table_id_text"
                android:textSize="@dimen/text_size_title"
                tools:text="₹ 46.25" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="@dimen/margin_large"
            android:background="@color/chip_border" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/grand_total"
                android:textColor="@color/table_id_text"
                android:textSize="@dimen/text_size_large"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvExpandedGrandTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/table_id_text"
                android:textSize="@dimen/text_size_20sp"
                android:textStyle="bold"
                tools:text="₹ 971.25" />
        </LinearLayout>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/pbOrderDetailLoading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:indeterminateTint="@color/chip_selected"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="visible" />

    <!-- Action Buttons Container -->
    <LinearLayout
        android:id="@+id/layoutActionButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/margin_medium"
        android:paddingBottom="@dimen/margin_xl"
        android:background="@color/white"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddMoreItems"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height_large"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/margin_small"
            android:text="Add Items"
            android:textAllCaps="false"
            android:textColor="@color/chip_selected"
            app:strokeColor="@color/chip_selected"
            app:strokeWidth="1dp"
            app:cornerRadius="@dimen/order_card_radius"
            android:textStyle="bold"
            android:visibility="visible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMarkAsServed"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height_large"
            android:layout_weight="1"
            android:backgroundTint="@color/chip_selected"
            android:text="@string/mark_as_served"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="@dimen/text_size_title"
            android:textStyle="bold"
            android:visibility="gone"
            app:cornerRadius="@dimen/order_card_radius" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGenerateBill"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height_large"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/margin_small"
            android:backgroundTint="@color/chip_selected"
            android:text="Generate Bill"
            android:textAllCaps="false"
            android:textColor="@color/white"
            app:cornerRadius="@dimen/order_card_radius"
            android:textStyle="bold"
            android:visibility="gone" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>