<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cvAlertRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    android:layout_marginHorizontal="2dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/white"
    app:strokeWidth="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="14dp">

        <ImageView
            android:id="@+id/ivAlertIcon"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:padding="8dp"
            android:background="#FFF9F2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <TextView
            android:id="@+id/tvAlertTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#212529"
            app:layout_constraintStart_toEndOf="@id/ivAlertIcon"
            app:layout_constraintEnd_toStartOf="@id/tvAlertTime"
            app:layout_constraintTop_toTopOf="@id/ivAlertIcon"
            tools:text="Table T-05" />

        <TextView
            android:id="@+id/tvAlertMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="14sp"
            android:textColor="#868E96"
            app:layout_constraintStart_toStartOf="@id/tvAlertTitle"
            app:layout_constraintEnd_toEndOf="@id/tvAlertTitle"
            app:layout_constraintTop_toBottomOf="@id/tvAlertTitle"
            tools:text="New order placed" />

        <TextView
            android:id="@+id/tvAlertTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="#868E96"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tvAlertTitle"
            tools:text="2 min ago" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>