<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cvClosedOrderRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="6dp"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="14dp"
    app:cardElevation="1dp"
    app:strokeWidth="1dp"
    app:strokeColor="#E5E7EB">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <TextView
            android:id="@+id/tvTableNumber"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textColor="#111827"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toStartOf="@id/tvPaymentStatusChip"
            tools:text="Table T-05" />

        <TextView
            android:id="@+id/tvOrderIdAndTime"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#6B7280"
            android:textSize="12sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTableNumber"
            app:layout_constraintEnd_toStartOf="@id/tvPaymentStatusChip"
            tools:text="#ORD-8118 • 12 Oct, 08:30 PM" />

        <TextView
            android:id="@+id/tvPaymentStatusChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_status_green"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="PAID • CASH"
            android:textColor="#065F46"
            android:textSize="11sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/divider1"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:background="#F3F4F6"
            app:layout_constraintTop_toBottomOf="@id/tvOrderIdAndTime" />

        <TextView
            android:id="@+id/tvItemsSummary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:textColor="#374151"
            android:textSize="13sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/tvGrandTotal"
            app:layout_constraintTop_toBottomOf="@id/divider1"
            tools:text="2x Paneer Butter Masala, 4x Butter Naan" />

        <TextView
            android:id="@+id/tvGrandTotal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="#10B981"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tvItemsSummary"
            tools:text="₹ 840" />

        <View
            android:id="@+id/divider2"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:background="#F3F4F6"
            app:layout_constraintTop_toBottomOf="@id/tvItemsSummary" />

        <!-- Waiter Info -->
        <ImageView
            android:id="@+id/ivWaiterIcon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginTop="8dp"
            android:src="@drawable/ic_person_24dp"
            app:tint="#6B7280"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/divider2" />

        <TextView
            android:id="@+id/tvWaiterName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:textColor="#4B5563"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="@id/ivWaiterIcon"
            app:layout_constraintStart_toEndOf="@id/ivWaiterIcon"
            app:layout_constraintTop_toTopOf="@id/ivWaiterIcon"
            app:layout_constraintEnd_toStartOf="@id/ivCashierIcon"
            tools:text="Waiter: John" />

        <!-- Cashier Info -->
        <ImageView
            android:id="@+id/ivCashierIcon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_card_payment_24dp"
            app:tint="#6B7280"
            app:layout_constraintBottom_toBottomOf="@id/ivWaiterIcon"
            app:layout_constraintEnd_toStartOf="@id/tvCashierName"
            app:layout_constraintTop_toTopOf="@id/ivWaiterIcon" />

        <TextView
            android:id="@+id/tvCashierName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:textColor="#4B5563"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="@id/ivWaiterIcon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/ivWaiterIcon"
            tools:text="Cashier: Priya" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
