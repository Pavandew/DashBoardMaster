<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/llUnpaidSectionRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Payment Method Selection -->
    <TextView
        android:id="@+id/tvPaymentMethodLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Select Payment Method"
        android:textColor="#111827"
        android:textSize="16sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/llPaymentOptions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical">

        <include
            android:id="@+id/layoutCash"
            layout="@layout/layout_payment_method_item" />

        <include
            android:id="@+id/layoutUpi"
            layout="@layout/layout_payment_method_item" />

        <include
            android:id="@+id/layoutCard"
            layout="@layout/layout_payment_method_item" />

        <include
            android:id="@+id/layoutWallet"
            layout="@layout/layout_payment_method_item" />

    </LinearLayout>

    <!-- Discount Section -->
    <TextView
        android:id="@+id/tvDiscountLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Discount (Optional)"
        android:textColor="#111827"
        android:textSize="16sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/llDiscountInputContainer"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp"
            app:strokeColor="#E5E7EB"
            app:strokeWidth="1dp">

            <EditText
                android:id="@+id/etDiscountInput"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@null"
                android:hint="Enter amount"
                android:inputType="numberDecimal"
                android:paddingHorizontal="16dp"
                android:textColor="#111827"
                android:textSize="15sp"
                android:autofillHints="none" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton android:maxLines="1" android:ellipsize="end" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="12sp" android:autoSizeMaxTextSize="18sp" android:autoSizeStepGranularity="1sp"
            android:id="@+id/btnApplyDiscount"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:text="Apply"
            app:cornerRadius="10dp" />
    </LinearLayout>
</LinearLayout>
