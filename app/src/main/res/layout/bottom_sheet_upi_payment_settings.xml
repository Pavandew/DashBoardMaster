<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_main"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Header Drag Indicator -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_search_bar" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="UPI &amp; Payment QR Settings"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Set your UPI ID &amp; QR Code for Cashier Billing Screens"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <!-- UPI VPA Input Field -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilUpiId"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:hint="Enter UPI ID (VPA)"
        app:boxStrokeColor="@color/mid_app_color"
        app:hintTextColor="@color/mid_app_color">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etUpiId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textEmailAddress"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            tools:text="myrestaurant@okicici" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="UPI Payment QR Code Image"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:textStyle="bold" />

    <!-- QR Image Preview Container -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        app:cardBackgroundColor="@color/bg_card"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeColor="#2C2E3B"
        app:strokeWidth="1dp">

        <ImageView
            android:id="@+id/ivQrPreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_upi_pay_24dp" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Upload/Select QR Image Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSelectQrImage"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:text="Upload QR Code Image"
        android:textColor="@color/mid_app_color"
        app:icon="@drawable/ic_edit_24dp"
        app:iconTint="@color/mid_app_color"
        app:strokeColor="@color/mid_app_color" />

    <!-- Progress Indicator -->
    <ProgressBar
        android:id="@+id/progressBarUpi"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:visibility="gone" />

    <!-- Save Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSaveUpi"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="20dp"
        android:text="Save UPI Settings"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        app:backgroundTint="@color/mid_app_color"
        app:cornerRadius="12dp" />

</LinearLayout>