<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:paddingTop="14dp"
    android:paddingHorizontal="16dp">

    <ImageView
        android:id="@+id/iconRow"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginBottom="14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="#4F46E5"
        tools:src="@drawable/ic_badge_24dp"
        tools:ignore="ContentDescription" />

    <TextView
        android:id="@+id/tvRowTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="14dp"
        android:textColor="#1F2937"
        android:textSize="15sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/tvRowValue"
        app:layout_constraintStart_toEndOf="@id/iconRow"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Field Title" />

    <TextView
        android:id="@+id/tvRowValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginBottom="14dp"
        android:textColor="#4B5563"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/tvRowTitle"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Field Value" />

    <View
        android:id="@+id/rowDivider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="#F3F4F6"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/tvRowTitle" />

</androidx.constraintlayout.widget.ConstraintLayout>
