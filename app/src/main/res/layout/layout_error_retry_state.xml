<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutErrorContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp"
    android:visibility="gone">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="72dp"
        android:layout_height="72dp"
        app:cardCornerRadius="36dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#FAF0E6"
        app:strokeWidth="0dp">

        <ImageView
            android:id="@+id/ivErrorStateIcon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_refresh_24dp"
            app:tint="@color/golden_icon_tint" />

    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/tvErrorStateTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Unable to Load Data"
        android:textColor="@color/dark_text"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvErrorStateMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="Please check your connection and tap retry to load again."
        android:textColor="@color/gray_text"
        android:textSize="13sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnErrorRetry"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginTop="20dp"
        android:paddingHorizontal="24dp"
        android:text="Retry Again"
        android:textColor="@color/white"
        app:backgroundTint="@color/portal_staff_primary"
        app:cornerRadius="12dp"
        app:icon="@drawable/ic_refresh_24dp"
        app:iconTint="@color/white" />

</LinearLayout>
