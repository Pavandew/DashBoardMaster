<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/childMenuRowContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="2dp"
    app:cardBackgroundColor="@android:color/transparent"
    app:cardCornerRadius="8dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp">

        <ImageView
            android:id="@+id/imgChildMenuIcon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginStart="16dp"
            android:contentDescription="Child Menu Icon"
            app:tint="#8E92A2"
            tools:src="@drawable/ic_dashboard_24dp" />

        <TextView
            android:id="@+id/txtChildMenuTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:textColor="#8E92A2"
            android:textSize="14sp"
            tools:text="Sub Menu Title" />

        <TextView
            android:id="@+id/badgeNotification"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_expired_badge"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:textColor="#DC2626"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="3" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
