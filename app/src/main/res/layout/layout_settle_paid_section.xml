<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cvPaidInfo"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="20dp"
    android:visibility="gone"
    app:cardBackgroundColor="#F0FDF4"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeColor="#BBF7D0"
    app:strokeWidth="1dp"
    tools:visibility="visible">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/success"
            android:contentDescription="Paid Success" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvPaidMethodValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Paid via Cash"
                android:textColor="#166534"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPaidTimeValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#15803D"
                android:textSize="13sp"
                tools:text="Confirmed at 09:15 PM" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>