<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_main"
    android:orientation="vertical"
    android:padding="24dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="20dp"
        android:background="#408C96A5" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Add New Category"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Category Cover Image (Optional)"
        android:textColor="#8C96A5"
        android:textSize="14sp"
        android:layout_marginBottom="8dp" />

    <FrameLayout
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardCategoryImgPicker"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:cardBackgroundColor="@color/bg_card"
            app:cardCornerRadius="16dp"
            app:strokeColor="#30FFFFFF"
            app:strokeWidth="1dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/ivCategoryPreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="center"
                android:src="@drawable/ic_restaurant_24dp"
                app:tint="#8C96A5" />

        </com.google.android.material.card.MaterialCardView>

        <ImageView
            android:id="@+id/ivClearCategoryImg"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="top|end"
            android:background="@drawable/bg_gender_tab"
            android:src="@drawable/ic_delete_24dp"
            android:visibility="gone"
            app:tint="#FF4D4D" />
    </FrameLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Category Name *"
        android:textColor="#8C96A5"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/etBottomSheetCategoryName"
        style="@style/FormEditTextStyle"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="24dp"
        android:hint="e.g., Pizza, Burgers, Desserts"
        android:inputType="textCapWords" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnBottomSheetSaveCategory"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:background="@drawable/bg_btn_color_gradient"
        android:text="Create Category"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold" />

</LinearLayout>