<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardItemRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeColor="#F3F4F6"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="12dp">

        <!-- Status Indicator Strip -->
        <View
            android:id="@+id/viewStatusStrip"
            android:layout_width="4dp"
            android:layout_height="0dp"
            android:layout_marginVertical="8dp"
            android:background="@color/accent_purple"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvExpandedItemName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="8dp"
            android:textColor="#111827"
            android:textSize="15sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/tvExpandedItemQtyPrice"
            app:layout_constraintStart_toEndOf="@id/viewStatusStrip"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Chicken Hyderabadi Biryani" />

        <TextView
            android:id="@+id/tvItemStatusLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#6B7280"
            android:textSize="11sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="@id/tvExpandedItemName"
            app:layout_constraintStart_toStartOf="@id/tvExpandedItemName"
            app:layout_constraintTop_toBottomOf="@id/tvExpandedItemName"
            tools:text="• Ready to Serve"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/tvExpandedItemQtyPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:textColor="#6B7280"
            android:textSize="13sp"
            app:layout_constraintBottom_toBottomOf="@id/tvExpandedItemRowTotal"
            app:layout_constraintEnd_toStartOf="@id/tvExpandedItemRowTotal"
            app:layout_constraintTop_toTopOf="@id/tvExpandedItemRowTotal"
            tools:text="1 x ₹200" />

        <TextView
            android:id="@+id/tvExpandedItemRowTotal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:textColor="#111827"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="₹200" />

        <TextView
            android:id="@+id/tvExpandedItemCustomization"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#6B7280"
            android:textSize="12sp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="@id/tvExpandedItemName"
            app:layout_constraintStart_toStartOf="@id/tvExpandedItemName"
            app:layout_constraintTop_toBottomOf="@id/tvItemStatusLabel"
            tools:text="+ Extra Spices" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
