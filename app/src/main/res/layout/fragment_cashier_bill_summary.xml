<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/llActions"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp">

            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginTop="40dp"
                android:src="@drawable/success" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Bill Generated Successfully!"
                android:textColor="#16A34A"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Bill has been generated"
                android:textColor="#6B7280"
                android:textSize="14sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="32dp"
                android:background="#F3F4F6" />

            <!-- Bill Details -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="vertical">

                <include
                    android:id="@+id/rowBillNumber"
                    layout="@layout/layout_summary_row" />

                <include
                    android:id="@+id/rowOrderId"
                    layout="@layout/layout_summary_row" />

                <include
                    android:id="@+id/rowTotalItems"
                    layout="@layout/layout_summary_row" />

                <include
                    android:id="@+id/rowTotalAmount"
                    layout="@layout/layout_summary_row" />

                <include
                    android:id="@+id/rowDiscount"
                    layout="@layout/layout_summary_row" />

                <include
                    android:id="@+id/rowPaymentMethod"
                    layout="@layout/layout_summary_row" />

                <include
                    android:id="@+id/rowReceivedAmount"
                    layout="@layout/layout_summary_row" />

                <include
                    android:id="@+id/rowChange"
                    layout="@layout/layout_summary_row" />

                <include
                    android:id="@+id/rowDateTime"
                    layout="@layout/layout_summary_row" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/llActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPrintBill"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Print Bill"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="#4F46E5"
            app:cornerRadius="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNewBill"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:text="New Bill"
            android:textAllCaps="false"
            android:textColor="#4F46E5"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="12dp"
            app:strokeColor="#4F46E5" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>