<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="140dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeColor="#F3F4F6"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_card_gradient"
        android:padding="12dp">

        <LinearLayout
            android:id="@+id/cardImgBg"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:background="@drawable/bg_card_2"
            android:gravity="center"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/cardIcon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_restaurant_24dp"
                app:tint="#4F46E5" />
        </LinearLayout>

        <TextView
            android:id="@+id/cardTvCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="25"
            android:textColor="#111827"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/cardImgBg"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/cardTvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="Total Restaurants"
            android:textColor="#374151"
            android:textSize="13sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@+id/cardSubtitle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/cardTvCount"
            app:layout_constraintTop_toBottomOf="@id/cardTvCount" />

        <TextView
            android:id="@+id/cardSubtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="All Registered"
            android:textColor="#9CA3AF"
            android:textSize="11sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/cardTvTitle"
            app:layout_constraintTop_toBottomOf="@id/cardTvTitle" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>