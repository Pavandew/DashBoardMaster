<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="10dp"
    android:layout_gravity="center_horizontal"
    android:backgroundTint="@android:color/white"
    app:cardCornerRadius="28dp"
    app:cardElevation="8dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Portal Badge -->
        <TextView
            android:id="@+id/tv_portal_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Single Restaurant Portal"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:background="@drawable/bg_portal_badge"
            android:layout_marginBottom="12dp"
            android:visibility="gone" />

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Welcome Back! 👋"
            style="@style/TextAppearance.MyApp.ToolbarTitle" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Sign in to your account to continue"
            style="@style/TextAppearance.MyApp.Subtitle" />

        <!-- Username Label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Phone Number"
            style="@style/TextAppearance.MyApp.TitleSmall" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/login_phone_layout"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            app:boxBackgroundMode="outline"
            app:boxCornerRadiusTopStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxStrokeWidth="1dp"
            app:boxStrokeWidthFocused="2dp"
            app:boxStrokeColor="#E3E5EF"
            app:errorEnabled="true"
            app:startIconDrawable="@drawable/ic_call_24dp"
            app:startIconTint="@color/black"
            app:hintTextColor="#8A8FA8">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/login_Phone_et"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:gravity="center_vertical"
                android:textColor="#111111"
                android:textSize="18sp"
                android:background="@null"
                android:inputType="phone" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Password Label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Password"
            style="@style/TextAppearance.MyApp.TitleSmall" />

        <!-- Password Field -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/login_password_layout"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            app:boxBackgroundMode="outline"
            app:boxCornerRadiusTopStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxStrokeWidth="1dp"
            app:boxStrokeWidthFocused="2dp"
            app:boxStrokeColor="#E3E5EF"
            app:endIconMode="password_toggle"
            app:errorEnabled="true"
            app:startIconTint="@color/black"
            app:endIconTint="@color/black"
            app:startIconDrawable="@drawable/ic_passkey_24dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/login_password_et"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#111111"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:gravity="center_vertical"
                android:textSize="18sp"
                android:textAllCaps="false"
                android:inputType="textPassword" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Forgot Password -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="12dp"
            android:gravity="end"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/login_tvForgotPassword"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="Forgot Password?"
                android:textColor="#5B67FF"
                style="@style/TextAppearance.MyApp.CaptionSmall" />
        </LinearLayout>

        <!-- Login Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/login_btn"
            style="@style/Button.MyApp.Large"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Login"
            app:cornerRadius="14dp"
            app:iconGravity="textStart"
            app:backgroundTint="@color/purple_gradient_end"
            app:iconPadding="10dp"
            app:iconTint="@android:color/white" />

        <!-- Create Account -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/login_dont_have_create_acc_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Don't have an account? "
                style="@style/TextAppearance.MyApp.CaptionSmall" />

            <TextView
                android:id="@+id/login_create_acc_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Create Account"
                android:textColor="#5B67FF"
                style="@style/TextAppearance.MyApp.CaptionSmall" />
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
