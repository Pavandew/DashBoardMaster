<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="10dp"
    android:layout_gravity="center_horizontal"
    android:backgroundTint="@android:color/white"
    app:cardCornerRadius="24dp"
    app:cardElevation="4dp"
    app:strokeColor="#E8EAF0"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <!-- Portal Badge -->
        <TextView
            android:id="@+id/tv_portal_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Single Restaurant Portal"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold"
            android:paddingHorizontal="12dp"
            android:paddingVertical="5dp"
            android:background="@drawable/bg_portal_badge"
            android:layout_marginBottom="10dp"
            android:visibility="gone" />

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Welcome back"
            android:textColor="@color/text_form_primary"
            android:textStyle="bold"
            android:textSize="23sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Sign in to your account to continue"
            android:textColor="@color/text_form_secondary"
            android:textSize="14sp" />

        <!-- Phone Number Label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Phone Number"
            android:textColor="@color/text_form_primary"
            android:textStyle="bold"
            android:textSize="13sp" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/login_phone_layout"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            app:boxBackgroundMode="outline"
            app:boxCornerRadiusTopStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxStrokeWidth="1dp"
            app:boxStrokeWidthFocused="2dp"
            app:boxStrokeColor="#E3E5EF"
            app:startIconDrawable="@drawable/ic_call_24dp"
            app:startIconTint="#4B35FF"
            app:prefixText="+91 "
            app:prefixTextColor="#111111"
            app:prefixTextAppearance="@style/TextAppearance.MyApp.PrefixText"
            app:hintEnabled="false"
            app:errorTextColor="@color/error_dark_red">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/login_Phone_et"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="52dp"
                android:gravity="center_vertical"
                android:textColor="#111111"
                android:textColorHint="@color/text_form_secondary"
                android:textSize="16sp"
                android:hint="Enter phone number"
                android:inputType="phone" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Password Label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Password"
            android:textColor="@color/text_form_primary"
            android:textStyle="bold"
            android:textSize="13sp" />

        <!-- Password Field -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/login_password_layout"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            app:boxBackgroundMode="outline"
            app:boxCornerRadiusTopStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxStrokeWidth="1dp"
            app:boxStrokeWidthFocused="2dp"
            app:boxStrokeColor="#E3E5EF"
            app:endIconMode="password_toggle"
            app:startIconDrawable="@drawable/ic_passkey_24dp"
            app:startIconTint="#4B35FF"
            app:endIconTint="#4B35FF"
            app:hintEnabled="false"
            app:errorTextColor="@color/error_dark_red">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/login_password_et"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="52dp"
                android:gravity="center_vertical"
                android:textColor="#111111"
                android:textColorHint="@color/text_form_secondary"
                android:textSize="16sp"
                android:textAllCaps="false"
                android:hint="Enter your password"
                android:inputType="textPassword" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Forgot Password -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp"
            android:gravity="end"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/login_tvForgotPassword"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="Forgot Password?"
                android:textColor="#4B35FF"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Login Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/login_btn"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Login"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="#4B35FF"
            app:cornerRadius="12dp"
            app:elevation="3dp" />

        <!-- Create Account -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/login_dont_have_create_acc_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Don't have an account? "
                android:textColor="#6E738A"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/login_create_acc_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="2dp"
                android:text="Create Account"
                android:textColor="#4B35FF"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>