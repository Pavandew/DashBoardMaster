<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="10dp"
    android:layout_gravity="center_horizontal"
    android:backgroundTint="@android:color/white"
    app:cardCornerRadius="24dp"
    app:cardElevation="4dp"
    app:strokeColor="#E8EAF0"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <!-- Portal Badge -->
        <TextView
            android:id="@+id/tv_portal_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Single Restaurant Portal"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold"
            android:paddingHorizontal="12dp"
            android:paddingVertical="5dp"
            android:background="@drawable/bg_portal_badge"
            android:layout_marginBottom="10dp"
            android:visibility="gone" />

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Welcome back"
            android:textColor="@color/text_form_primary"
            android:textStyle="bold"
            android:textSize="23sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Sign in to your account to continue"
            android:textColor="@color/text_form_secondary"
            android:textSize="14sp" />

        <!-- Phone Number Label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Phone Number"
            android:textColor="@color/text_form_primary"
            android:textStyle="bold"
            android:textSize="13sp" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/login_phone_layout"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_form_surface"
            app:boxBackgroundMode="none"
            app:boxCornerRadiusTopStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxStrokeWidth="1dp"
            app:boxStrokeWidthFocused="2dp"
            app:boxStrokeColor="#D9DDE8"
            app:hintEnabled="false"
            app:errorEnabled="false"
            app:errorTextColor="@color/error_dark_red">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_margin="1dp"
                android:background="@android:color/white"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="54dp"
                    android:gravity="center_vertical"
                    android:includeFontPadding="false"
                    android:text="+91"
                    android:textColor="#555B70"
                    android:textSize="16sp" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="22dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:background="#D9DDE8" />

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/login_Phone_et"
                    android:layout_width="0dp"
                    android:layout_height="54dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical|start"
                    android:includeFontPadding="false"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:paddingTop="0dp"
                    android:paddingBottom="0dp"
                    android:background="@android:color/transparent"
                    android:importantForAutofill="no"
                    android:autofillHints=""
                    android:textDirection="ltr"
                    android:textAlignment="viewStart"
                    android:textColor="#000000"
                    android:textColorHint="#8A8FA3"
                    android:textSize="16sp"
                    android:hint="Enter 10-digit mobile number"
                    android:inputType="phone"
                    android:digits="0123456789"
                    android:singleLine="true"
                    android:maxLines="1"
                    android:maxLength="10"
                    android:imeOptions="actionNext"
                    android:scrollHorizontally="true" />

            </LinearLayout>

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Password Label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Password"
            android:textColor="@color/text_form_primary"
            android:textStyle="bold"
            android:textSize="13sp" />

        <!-- Password Field -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/login_password_layout"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_form_surface"
            app:boxBackgroundMode="none"
            app:boxCornerRadiusTopStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusBottomEnd="12dp"
            app:endIconMode="password_toggle"
            app:endIconTint="#777E94"
            app:hintEnabled="false"
            app:errorEnabled="false"
            app:errorTextColor="@color/error_dark_red">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/login_password_et"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_margin="1dp"
                android:background="@android:color/transparent"
                android:importantForAutofill="no"
                android:autofillHints=""
                android:gravity="center_vertical|start"
                android:includeFontPadding="false"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:textColor="#000000"
                android:textColorHint="#8A8FA3"
                android:textSize="16sp"
                android:textAllCaps="false"
                android:hint="Enter your password"
                android:inputType="textPassword"
                android:singleLine="true"
                android:maxLines="1"
                android:imeOptions="actionDone" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Forgot Password -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp"
            android:gravity="end"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/login_tvForgotPassword"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="Forgot Password?"
                android:textColor="#4B35FF"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Login Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/login_btn"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Login"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="#4B35FF"
            app:cornerRadius="12dp"
            app:elevation="3dp" />

        <!-- Create Account -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/login_dont_have_create_acc_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Don't have an account? "
                android:textColor="#6E738A"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/login_create_acc_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="2dp"
                android:text="Create New Account"
                android:textColor="#4B35FF"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>