<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://tools.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    tools:context=".manager_single_res_dash.home.views.StaffDetailFragment">

    <include
        android:id="@+id/detailToolbar"
        layout="@layout/staff_custom_toolbar"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ProgressBar
        android:id="@+id/detailProgressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:theme="@style/Widget.AppCompat.ProgressBar"
        app:layout_constraintTop_toBottomOf="@id/detailToolbar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/detailScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/detailToolbar"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#1F1F2E"
                app:cardCornerRadius="16dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/imgStaffAvatar"
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:src="@drawable/person"
                        android:background="#2E2E42"
                        android:padding="8dp"
                        app:shapeAppearanceOverlay="@style/CircleImage" />

                    <TextView
                        android:id="@+id/tvDetailName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:textColor="@android:color/white"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:text="Staff Member Name" />

                    <TextView
                        android:id="@+id/tvDetailRoleAndId"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="#A0A0B0"
                        android:textSize="16sp"
                        android:text="Role Designation • ID: ----- " />

                    <TextView
                        android:id="@+id/tvDetailStatusTag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_status_active"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="4dp"
                        android:textColor="#27AE60"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:text="Active" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Employment Record Information"
                android:textColor="#A0A0B0"
                android:textSize="14sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#1F1F2E"
                app:cardCornerRadius="12dp"
                app:strokeWidth="0dp">

                <TableLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp"
                    android:stretchColumns="1">

                    <TableRow android:paddingVertical="8dp">
                        <TextView
                            android:text="Joining Date"
                            android:textColor="#A0A0B0"
                            android:paddingEnd="16dp"
                            android:textSize="16sp"/>
                        <TextView
                            android:id="@+id/tvDetailJoinDate"
                            android:textColor="@android:color/white"
                            android:textSize="16sp"
                            android:gravity="start"
                            tools:text="--/--/----"/>
                    </TableRow>

                    <TableRow android:paddingVertical="8dp">
                        <TextView
                            android:text="Department"
                            android:textColor="#A0A0B0"
                            android:paddingEnd="16dp"
                            android:textSize="16sp"/>
                        <TextView
                            android:id="@+id/tvDetailDepartment"
                            android:textColor="@android:color/white"
                            android:textSize="16sp"
                            android:gravity="start"
                            tools:text="Kitchen/Floor"/>
                    </TableRow>

                    <TableRow android:paddingVertical="8dp">
                        <TextView
                            android:text="Duty Shift"
                            android:textColor="#A0A0B0"
                            android:paddingEnd="16dp"
                            android:textSize="16sp"/>
                        <TextView
                            android:id="@+id/tvDetailShift"
                            android:textColor="@android:color/white"
                            android:textSize="16sp"
                            android:gravity="start"
                            tools:text="Morning/Night"/>
                    </TableRow>

                    <TableRow android:paddingVertical="8dp">
                        <TextView
                            android:text="Salary Structure"
                            android:textColor="#A0A0B0"
                            android:paddingEnd="16dp"
                            android:textSize="16sp"/>
                        <TextView
                            android:id="@+id/tvDetailSalary"
                            android:textColor="@android:color/white"
                            android:textSize="16sp"
                            android:gravity="start"
                            tools:text="₹ 00,000"/>
                    </TableRow>
                </TableLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Contact Parameters &amp; Security Credentials"
                android:textColor="#A0A0B0"
                android:textSize="14sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#1F1F2E"
                app:cardCornerRadius="12dp"
                app:strokeWidth="0dp">

                <TableLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp"
                    android:stretchColumns="1">

                    <TableRow android:paddingVertical="8dp">
                        <TextView
                            android:text="Mobile Number"
                            android:textColor="#A0A0B0"
                            android:paddingEnd="16dp"
                            android:textSize="16sp"/>
                        <TextView
                            android:id="@+id/tvDetailMobile"
                            android:textColor="@android:color/white"
                            android:textSize="16sp"
                            android:gravity="start"
                            tools:text="+91 ------"/>
                    </TableRow>

                    <TableRow android:paddingVertical="8dp">
                        <TextView
                            android:text="Email Identity"
                            android:textColor="#A0A0B0"
                            android:paddingEnd="16dp"
                            android:textSize="16sp"/>
                        <TextView
                            android:id="@+id/tvDetailEmail"
                            android:textColor="@android:color/white"
                            android:textSize="16sp"
                            android:gravity="start"
                            tools:text="---@email.com"/>
                    </TableRow>

                    <TableRow android:paddingVertical="8dp">
                        <TextView
                            android:text="Gender"
                            android:textColor="#A0A0B0"
                            android:paddingEnd="16dp"
                            android:textSize="16sp"/>
                        <TextView
                            android:id="@+id/tvDetailGender"
                            android:textColor="@android:color/white"
                            android:textSize="16sp"
                            android:gravity="start"
                            tools:text="Male/Female"/>
                    </TableRow>
                </TableLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="KYC Verification Documents"
                android:textColor="#A0A0B0"
                android:textSize="14sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#1F1F2E"
                app:cardCornerRadius="12dp"
                app:strokeWidth="0dp">

                <TableLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp"
                    android:stretchColumns="1">

                    <TableRow android:paddingVertical="8dp">
                        <TextView
                            android:text="Document Type"
                            android:textColor="#A0A0B0"
                            android:paddingEnd="16dp"
                            android:textSize="16sp"/>
                        <TextView
                            android:id="@+id/tvDetailDocType"
                            android:textColor="@android:color/white"
                            android:textSize="16sp"
                            android:gravity="start"
                            tools:text="Aadhar/PAN"/>
                    </TableRow>

                    <TableRow android:paddingVertical="8dp">
                        <TextView
                            android:text="Document ID Number"
                            android:textColor="#A0A0B0"
                            android:paddingEnd="16dp"
                            android:textSize="16sp"/>
                        <TextView
                            android:id="@+id/tvDetailDocNumber"
                            android:textColor="@android:color/white"
                            android:textSize="16sp"
                            android:gravity="start"
                            tools:text="0000 0000 0000"/>
                    </TableRow>
                </TableLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>