<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="12dp">

    <ImageView
        android:id="@+id/activityIcon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/bg_card_2"
        android:padding="12dp"
        android:src="@drawable/person"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <TextView
        android:id="@+id/activityTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Restaurant Created"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:textAppearance="@style/TextAppearance.MyApp.ActivityTitle"
        app:layout_constraintStart_toEndOf="@id/activityIcon"
        app:layout_constraintTop_toTopOf="@id/activityIcon"
        app:layout_constraintEnd_toStartOf="@id/activityDate"
        app:layout_constraintBottom_toTopOf="@id/activitySubtitle" />

    <TextView
        android:id="@+id/activitySubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Spice villa"
        android:layout_marginEnd="8dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:textAppearance="@style/TextAppearance.MyApp.ActivitySubtext"
        app:layout_constraintStart_toStartOf="@id/activityTitle"
        app:layout_constraintTop_toBottomOf="@id/activityTitle"
        app:layout_constraintEnd_toStartOf="@id/activityDate"
        app:layout_constraintBottom_toBottomOf="parent" />

    <TextView
        android:id="@+id/activityDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="may 2024"
        android:layout_marginEnd="8dp"
        android:textAppearance="@style/TextAppearance.MyApp.ActivityMeta"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/activityTitle"
        app:layout_constraintBottom_toTopOf="@id/activityTime" />

    <TextView
        android:id="@+id/activityTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="10:10 AM"
        android:layout_marginEnd="8dp"
        android:textAppearance="@style/TextAppearance.MyApp.CaptionSmall"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/activityDate"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>