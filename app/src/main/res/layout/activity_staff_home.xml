<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".staff_dash.home.StaffHomeActivity">

        <!-- Main Screen -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Fragment Container -->
            <androidx.fragment.app.FragmentContainerView
                android:id="@+id/staff_home_fragment_container"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@id/staff_host_bottom_nav"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Bottom Navigation -->
            <com.google.android.material.bottomnavigation.BottomNavigationView
                android:id="@+id/staff_host_bottom_nav"
                style="@style/CustomBottomNavigation"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:background="@drawable/bottom_nav_background"
                app:itemIconTint="@color/nav_item_color_state"
                app:itemTextColor="@color/nav_item_color_state"
                app:labelVisibilityMode="labeled"
                app:elevation="8dp"
                app:menu="@menu/staff_bottom_menu"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Side Drawer -->
        <!--    app:headerLayout="@layout/drawer_header"-->
        <com.google.android.material.navigation.NavigationView
            android:id="@+id/staff_navigationView"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            android:background="@color/white"
            app:headerLayout="@layout/drawer_header"
            app:menu="@menu/drawer_menu"
            app:itemIconTint="#5B3FFF"
            app:itemTextColor="#222222"
            app:itemBackground="@drawable/bg_drawer_item" />

</androidx.drawerlayout.widget.DrawerLayout>