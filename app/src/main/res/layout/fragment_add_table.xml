<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    tools:context=".manager_single_res_dash.views.AddTableFragment">

    <include
        android:id="@+id/addTableToolbar"
        layout="@layout/staff_custom_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/btnSaveTableAction"
        app:layout_constraintTop_toBottomOf="@id/addTableToolbar">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp">

            <!-- Table Name -->
            <TextView
                android:id="@+id/lblTableName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Table Name *"
                android:textColor="#8C96A5"
                android:textSize="14sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilTableNameWrapper"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:boxBackgroundColor="#131926"
                app:boxStrokeColor="#2E3241"
                app:boxCornerRadiusTopStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusBottomEnd="12dp"
                app:counterEnabled="true"
                app:counterMaxLength="20"
                app:counterTextColor="@android:color/darker_gray"
                app:hintEnabled="false"
                app:layout_constraintTop_toBottomOf="@id/lblTableName">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etTableNameField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Enter Table Name (e.g. T1, VIP-1, Table 5)"
                    android:inputType="textCapWords"
                    android:maxLength="20"
                    android:textColor="@android:color/white"
                    android:textSize="16sp"
                    tools:text="T-15" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Floor (Read-Only) -->
            <TextView
                android:id="@+id/lblFloorSelection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Floor *"
                android:textColor="#8C96A5"
                android:textSize="14sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tilTableNameWrapper" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilFloorInputWrapper"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:boxBackgroundColor="#131926"
                app:boxStrokeColor="#2E3241"
                app:boxCornerRadiusTopStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusBottomEnd="12dp"
                app:hintEnabled="false"
                app:layout_constraintTop_toBottomOf="@id/lblFloorSelection">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etFloorDisplay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:enabled="false"
                    android:textColor="#9CA3AF"
                    android:textSize="16sp"
                    tools:text="Ground Floor" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Capacity Counter -->
            <TextView
                android:id="@+id/lblCapacity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Capacity (Seats) *"
                android:textColor="#8C96A5"
                android:textSize="14sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tilFloorInputWrapper" />

            <LinearLayout
                android:id="@+id/llCapacityCounterContainer"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_et"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/lblCapacity">

                <ImageButton
                    android:id="@+id/btnDecrementCapacity"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackground"
                    android:src="@drawable/ic_remove_24dp"
                    app:tint="@android:color/white" />

                <TextView
                    android:id="@+id/tvCapacityValue"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="2"
                    android:background="@android:color/transparent"
                    android:gravity="center"
                    android:text="4"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btnIncrementCapacity"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackground"
                    android:src="@drawable/ic_add_24dp"
                    app:tint="@android:color/white" />
            </LinearLayout>

            <!-- Table Type Selection -->
            <TextView
                android:id="@+id/lblTableType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Table Type *"
                android:textColor="#8C96A5"
                android:textSize="14sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/llCapacityCounterContainer" />

            <LinearLayout
                android:id="@+id/llTypeRowOne"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="6dp"
                android:orientation="horizontal"
                app:layout_constraintTop_toBottomOf="@id/lblTableType">

                <TextView
                    android:id="@+id/btnTypeRegular"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_et"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="Regular"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnTypeFamily"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_et"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="Family"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/llTypeRowTwo"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                app:layout_constraintTop_toBottomOf="@id/llTypeRowOne">

                <TextView
                    android:id="@+id/btnTypeVip"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_et"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="VIP"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnTypeOutdoor"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_et"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="Outdoor"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Table Status -->
            <TextView
                android:id="@+id/lblTableStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Status"
                android:textColor="#8C96A5"
                android:textSize="14sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/llTypeRowTwo" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilStatusDropdownWrapper"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:boxBackgroundColor="#131926"
                app:boxStrokeColor="#2E3241"
                app:boxCornerRadiusTopStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusBottomEnd="12dp"
                app:hintEnabled="false"
                app:endIconTint="@android:color/white"
                app:layout_constraintTop_toBottomOf="@id/lblTableStatus">

                <AutoCompleteTextView
                    android:id="@+id/actvStatusDropdown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:textColor="@android:color/white"
                    android:textSize="16sp"
                    tools:text="Available" />
            </com.google.android.material.textfield.TextInputLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnSaveTableAction"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_margin="16dp"
        android:background="@drawable/bg_btn_color_gradient"
        android:text="Save Table"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_height="wrap_content"
        android:layout_width="wrap_content"
        android:visibility="gone"
        android:indeterminateDrawable="@drawable/progress_golden_gradient"
        android:elevation="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
