<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".staff_dash.waiter_screens.table.views.ViewCartDetailsFragment">

    <!-- Toolbar -->
    <include
        android:id="@+id/view_cart_toolbar"
        layout="@layout/staff_custom_toolbar"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCartItems"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingTop="@dimen/margin_small"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/view_cart_toolbar"
        app:layout_constraintBottom_toTopOf="@id/linear1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Bottom Content -->
    <LinearLayout
        android:id="@+id/linear1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/margin_medium"
        app:layout_constraintBottom_toTopOf="@id/btnSendToKitchen"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Order Notes Title -->
        <TextView
            android:id="@+id/tvOrder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/margin_large"
            android:layout_marginTop="@dimen/margin_medium"
            android:text="Order Notes (Optional)"
            android:textColor="@color/gray_text"
            android:textSize="@dimen/text_size_body" />

        <!-- Order Notes Field -->
        <EditText
            android:id="@+id/etOrderNotes"
            android:layout_width="match_parent"
            android:layout_height="@dimen/food_img_size"
            android:layout_marginHorizontal="@dimen/margin_large"
            android:layout_marginTop="@dimen/margin_small"
            android:background="@drawable/bg_order_notes"
            android:gravity="top|start"
            android:hint="Write special note..."
            android:inputType="textMultiLine"
            android:padding="@dimen/margin_medium"
            android:textColor="@color/search_bar_text"
            android:textColorHint="@color/search_bar_hint"
            android:textSize="@dimen/text_size_body" />

        <!-- Price Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/margin_large"
            android:layout_marginTop="@dimen/padding_large"
            android:orientation="vertical">

            <!-- Subtotal -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Subtotal"
                    android:textColor="@color/chip_unselected_text"
                    android:textSize="@dimen/text_size_title" />

                <TextView
                    android:id="@+id/tvSubtotalPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₹ 925"
                    android:textColor="@color/table_id_text"
                    android:textSize="@dimen/text_size_title" />
            </LinearLayout>

            <!-- GST -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="GST (5%)"
                    android:textColor="@color/chip_unselected_text"
                    android:textSize="@dimen/text_size_title" />

                <TextView
                    android:id="@+id/tvGstPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₹ 46.25"
                    android:textColor="@color/table_id_text"
                    android:textSize="@dimen/text_size_title" />
            </LinearLayout>

            <!-- Total -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/table_card_padding"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Total"
                    android:textColor="@color/table_id_text"
                    android:textSize="@dimen/text_size_large"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvGrandTotalPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₹ 971.25"
                    android:textColor="@color/table_id_text"
                    android:textSize="@dimen/text_size_large"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- Bottom Button -->
    <Button
        android:id="@+id/btnSendToKitchen"
        android:layout_width="0dp"
        android:layout_height="@dimen/button_height_large"
        android:layout_marginHorizontal="@dimen/margin_medium"
        android:layout_marginBottom="27dp"
        android:backgroundTint="@color/chip_selected"
        android:text="Send to Kitchen"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="@dimen/text_size_title"
        android:textStyle="bold"
        app:cornerRadius="@dimen/alert_card_radius"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>