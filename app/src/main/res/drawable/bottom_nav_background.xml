<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <!-- Rounded top corners so the bottom nav looks elevated above content -->
    <corners android:topLeftRadius="16dp" android:topRightRadius="16dp" />

    <!-- Colorful horizontal gradient (left -> right) -->
    <gradient
        android:angle="0"
        android:startColor="#6A4DFF"
        android:endColor="#3AA0FF"
        android:type="linear" />

    <!-- Slight inner padding via padding tag (visual spacing) -->
    <padding android:left="6dp" android:top="6dp" android:right="6dp" android:bottom="6dp" />
</shape>

