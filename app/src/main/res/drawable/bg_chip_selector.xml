<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#3554FF" />
            <corners android:radius="28dp" />
            <padding
                android:bottom="9dp"
                android:left="18dp"
                android:right="18dp"
                android:top="9dp" />
        </shape>
    </item>

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#E8ECFF" />
            <stroke android:width="1.5dp" android:color="#3554FF" />
            <corners android:radius="28dp" />
            <padding
                android:bottom="9dp"
                android:left="18dp"
                android:right="18dp"
                android:top="9dp" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
            <stroke android:width="1.2dp" android:color="#9CA3AF" />
            <corners android:radius="28dp" />
            <padding
                android:bottom="9dp"
                android:left="18dp"
                android:right="18dp"
                android:top="9dp" />
        </shape>
    </item>

</selector>