<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MasterDashboard">
        <activity
            android:name=".staff_dash.home.StaffHomeActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustPan" />
        <activity
            android:name=".staff_dash.login.StaffLoginActivity"
            android:exported="false" />
        <activity
            android:name=".ActivityVisitorPortal"
            android:exported="false" />
        <activity
            android:name=".SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".master_dash.login.views.OTPVerificationActivity"
            android:exported="false" />
        <activity
            android:name=".master_dash.home.MasterHomeActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustPan" />
        <activity
            android:name=".master_dash.login.views.SignUpActivity"
            android:exported="false" />
        <activity
            android:name=".master_dash.login.views.LoginActivity"
            android:exported="false" />
    </application>

</manifest>